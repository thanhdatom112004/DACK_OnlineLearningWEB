# --- Server ---
PORT=3001
JWT_SECRET=thay-bang-chuoi-bi-mat-dai

# --- MongoDB (chọn một trong hai cách) ---
MONGODB_URI=mongodb://127.0.0.1:27017/onlinelearning
# Hoặc Atlas:
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_HOSTS=cluster0.xxxxx.mongodb.net
# MONGODB_DB=onlinelearning

# --- SMTP (bắt buộc để gửi OTP quên mật khẩu) ---
# Ví dụ Gmail: bật xác minh 2 bước → Mật khẩu ứng dụng (App password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 587 = STARTTLS (mặc định secure=false). 465 = SSL (tự bật secure)
# SMTP_SECURE=false
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password
# Người gửi hiển thị (nên trùng domain/spf nếu có)
SMTP_FROM="Online Learning <your.email@gmail.com>"

# Tùy chọn: chỉ khi dev bị lỗi chứng chỉ TLS
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# OTP hết hạn sau N phút
PASSWORD_RESET_OTP_MINUTES=10
# OTP xác thực email (profile)
EMAIL_VERIFY_OTP_MINUTES=15
